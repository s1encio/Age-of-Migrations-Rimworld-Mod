    <isPlayer>true</isPlayer>
    <pawnSingular>Persian</pawnSingular>
    <pawnsPlural>Persians</pawnsPlural>
    <basicMemberKind>LR_PersiansSettler</basicMemberKind>
    <techLevel>Medieval</techLevel>
    <backstoryCategories><li>Outlander</li></backstoryCategories>
    <factionIconPath>World/LR_CapitalPersian</factionIconPath>
    <colorSpectrum><li>(0.75, 0.6, 0.15)</li></colorSpectrum>
    <playerInitialSettlementNameMaker>LR_NamerSettlementPersian</playerInitialSettlementNameMaker>
    <factionNameMaker>LR_NamerFactionPersian</factionNameMaker>
    <settlementNameMaker>LR_NamerSettlementPersian</settlementNameMaker>
    <allowedCultures><li>LR_PersianCulture</li></allowedCultures>
    <startingResearchTags><li>TribalStart</li><li>LR_CivilStart</li></startingResearchTags>
    <apparelStuffFilter><thingDefs><li>Cloth</li><li>WoolSheep</li></thingDefs></apparelStuffFilter>
    <modExtensions>
      <li Class="AgeOfMigrations.ResearchCulture"><culture>Persian</culture></li>
    </modExtensions>
  </FactionDef>
</Defs>
