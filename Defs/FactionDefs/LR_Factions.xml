<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>LR_WesternEmpire</defName>
    <label>Western Roman Empire</label>
    <description>The western half of the Roman Empire, ruled from Ravenna. Its legions are worn thin by civil wars and endless barbarian incursions, and its generals are often more powerful than the emperor. Still, its soldiers fight in disciplined lines behind oval shields, throwing plumbatae before closing with spear and spatha.</description>
    <pawnSingular>Roman</pawnSingular>
    <pawnsPlural>Romans</pawnsPlural>
    <listOrderPriority>30</listOrderPriority>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <configurationListOrderPriority>40</configurationListOrderPriority>
    <canMakeRandomly>true</canMakeRandomly>
    <canStageAttacks>true</canStageAttacks>
    <techLevel>Medieval</techLevel>
    <leaderTitle>augustus</leaderTitle>
    <factionIconPath>World/LR_FactionIcon</factionIconPath>
    <settlementTexturePath>World/LR_Settlement</settlementTexturePath>
    <colorSpectrum><li>(0.62, 0.16, 0.13)</li><li>(0.75, 0.22, 0.16)</li></colorSpectrum>
    <factionNameMaker>LR_NamerFactionWest</factionNameMaker>
    <settlementNameMaker>LR_NamerSettlementWest</settlementNameMaker>
    <allowedCultures><li>LR_RomanCulture</li></allowedCultures>
    <backstoryCategories><li>Outlander</li></backstoryCategories>
    <apparelStuffFilter><thingDefs><li>Cloth</li><li>WoolSheep</li></thingDefs></apparelStuffFilter>
    <basicMemberKind>LR_West_Legionarius</basicMemberKind>
