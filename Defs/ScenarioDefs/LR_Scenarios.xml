<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>LR_ScenarioRomans</defName>
    <label>Western Roman Empire</label>
    <description>Rule a city of the Western Empire: its walls, houses, workshops and stores are yours from the first day.</description>
    <scenario>
      <summary>Rule a Roman city of the West. Choose which one on the world map: Ravenna is the imperial capital.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>LR_PlayerRomans</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>7</pawnCount>
          <pawnChoiceCount>10</pawnChoiceCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>
        <li Class="AgeOfMigrations.ScenPart_People">
          <def>LR_People</def>
          <people>LR_WesternEmpire</people><ruleCity>true</ruleCity>
        </li>
        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <animalKind>Horse</animalKind>
          <count>2</count>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>This city is yours to rule. Its walls, houses, workshops and stores came with it; its people look to you. Keep it fed, keep it defended, and make it great.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>
