        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The King of Kings has granted your house land on the frontier. Build a fortress of brick, light the sacred fire, and hold the land in his name.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>
