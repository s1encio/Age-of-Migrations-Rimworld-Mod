<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <CultureDef>
    <defName>LR_GothicCulture</defName>
    <label>gothic</label>
    <description>The culture of the Goths of the migration age: horsemen and warriors who lived for generations beside the Roman frontier, half-Romanised, proud of their royal houses, Arian Christians with a Bible in their own tongue.</description>
    <pawnNameMaker>LR_NamerPersonGoth</pawnNameMaker>
    <pawnNameMakerFemale>LR_NamerPersonGothFemale</pawnNameMakerFemale>
    <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoCorunan</ideoNameMaker>
    <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityCorunan</deityNameMaker>
    <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DeityTypeMakerCorunan</deityTypeMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalCorunan</festivalNameMaker>
    <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">LR_VandalLeaderTitleMaker</leaderTitleMaker>
    <allowedPlaceTags><li>OriginTribal</li></allowedPlaceTags>
    <iconPath>World/LR_GothIcon</iconPath>
    <iconColor>(0.4, 0.55, 0.8)</iconColor>
    <preferredWeaponClasses>
      <noble>MeleePiercer</noble>
      <despised>Ultratech</despised>
    </preferredWeaponClasses>
    <styleItemTags>
      <li><tag>Tribal</tag><baseWeight>0.8</baseWeight><weightFactor>1</weightFactor></li>
      <li><tag>Rural</tag><baseWeight>0.8</baseWeight><weightFactor>1</weightFactor></li>
      <li><tag>BeardTribal</tag><baseWeight>0.8</baseWeight><weightFactor>1</weightFactor></li>
      <li><tag>NoBeard</tag><baseWeight>0.3</baseWeight><weightFactor>1</weightFactor></li>
      <li><tag>NoTattoo</tag><baseWeight>1</baseWeight><weightFactor>1</weightFactor></li>
    </styleItemTags>
  </CultureDef>
</Defs>
