<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <TerrainDef ParentName="FloorBase">
    <defName>LR_WallWalk</defName>
    <label>wall walk</label>
    <description>The paved top of a city wall, between the battlements and the curtain wall. Archers standing on it aim better and are harder to hit from below.</description>
    <texturePath>Terrain/LR/LR_WallWalk</texturePath>
    <edgeType>Hard</edgeType>
    <renderPrecedence>253</renderPrecedence>
    <statBases><WorkToBuild>700</WorkToBuild><Beauty>0</Beauty></statBases>
    <costList><BlocksGranite>3</BlocksGranite></costList>
    <researchPrerequisites><li>Stonecutting</li></researchPrerequisites>
    <designationCategory IsNull="True" />
    <modExtensions><li Class="AgeOfMigrations.WallWalkExtension" /></modExtensions>
  </TerrainDef>
  <TerrainDef ParentName="FloorBase">
    <defName>LR_TimberWalk</defName>
    <label>fighting platform</label>
    <description>A timber platform on top of an earth rampart, behind a breastwork palisade. Archers standing on it aim better and are harder to hit from below.</description>
    <texturePath>Terrain/LR/LR_TimberWalk</texturePath>
    <edgeType>Hard</edgeType>
    <renderPrecedence>253</renderPrecedence>
    <statBases><WorkToBuild>400</WorkToBuild><Beauty>0</Beauty><Flammability>0.4</Flammability></statBases>
    <costList><WoodLog>3</WoodLog></costList>
    <designationCategory IsNull="True" />
    <modExtensions><li Class="AgeOfMigrations.WallWalkExtension" /></modExtensions>
  </TerrainDef>
</Defs>
