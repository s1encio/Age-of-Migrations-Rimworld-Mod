<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="LR_VanillaBed">
    <defName>LR_Bed</defName>
    <label>wooden bed</label>
    <description>A wooden bed frame with turned posts, a straw-stuffed mattress, linen and a red wool blanket.</description>
    <graphicData>
      <texPath>Things/Building/LR/Furniture/LR_Bed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1.05, 2.1)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/LR/Furniture/LR_Bed_south</uiIconPath>
  </ThingDef>
  <ThingDef ParentName="LR_VanillaDoubleBed">
    <defName>LR_DoubleBed</defName>
    <label>wide bed</label>
    <description>A wide wooden bed for two, with turned posts, linen and a blue wool coverlet.</description>
    <graphicData>
      <texPath>Things/Building/LR/Furniture/LR_DoubleBed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2.1, 2.1)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/LR/Furniture/LR_DoubleBed_south</uiIconPath>
  </ThingDef>
  <ThingDef ParentName="LR_VanillaBedroll">
    <defName>LR_StrawBed</defName>
    <label>straw pallet</label>
    <description>A sack of straw on the ground with a rough wool blanket: how most people slept in camp, on the march, or in a crowded house.</description>
    <graphicData>
      <texPath>Things/Building/LR/Furniture/LR_StrawBed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
