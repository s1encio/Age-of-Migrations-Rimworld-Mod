  <ThingDef ParentName="LR_VanillaShelfSmall">
    <defName>LR_Chest</defName>
    <label>chest</label>
    <description>An iron-bound wooden chest with a lock, for clothes, coin and anything worth keeping.</description>
    <graphicData>
