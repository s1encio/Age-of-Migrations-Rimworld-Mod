      <damageData><enabled>false</enabled></damageData>
    </graphicData>
    <uiIconPath>Things/Building/LR/LR_CampGate_MenuIcon_south</uiIconPath>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <size>(3, 1)</size>
    <rotatable>true</rotatable>
    <costStuffCount>90</costStuffCount>
    <stuffCategories Inherit="False"><li>Woody</li></stuffCategories>
    <costList><Steel>10</Steel></costList>
