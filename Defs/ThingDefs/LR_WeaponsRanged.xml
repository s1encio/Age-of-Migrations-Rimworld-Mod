<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseWeaponNeolithic">
    <defName>LR_Sling</defName>
    <label>sling</label>
    <description>A pair of braided cords with a leather pouch, used to hurl lead bullets or stones. Cheap, long-ranged and quick, but the bullets do little against armor.</description>
    <techLevel>Medieval</techLevel>
    <thingClass>AgeOfMigrations.ThingWithEquippedGraphic</thingClass>
    <modExtensions>
      <li Class="AgeOfMigrations.EquippedGraphicExtension">
        <equippedGraphicData>
          <texPath>Things/Item/Equipment/WeaponRanged/LR_Sling_Held</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </equippedGraphicData>
      </li>
    </modExtensions>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/LR_Sling</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>1800</WorkToMake>
      <Mass>0.3</Mass>
      <AccuracyTouch>0.6</AccuracyTouch>
      <AccuracyShort>0.55</AccuracyShort>
      <AccuracyMedium>0.42</AccuracyMedium>
      <AccuracyLong>0.3</AccuracyLong>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <costList><Cloth>15</Cloth></costList>
    <weaponTags><li>LR_RomanRanged</li><li>LR_Sling</li></weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>LR_Sling_Proj</defaultProjectile>
        <warmupTime>1.2</warmupTime>
        <range>25.9</range>
        <soundCast>Bow_Small</soundCast>
      </li>
    </verbs>
    <tools><li><label>cord</label><capacities><li>Blunt</li></capacities><power>4</power><cooldownTime>2</cooldownTime></li></tools>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <recipeUsers Inherit="False"><li>CraftingSpot</li><li>FueledSmithy</li><li>ElectricSmithy</li></recipeUsers>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>LR_Sling_Proj</defName>
    <label>sling bullet</label>
    <graphicData>
      <texPath>Things/Projectile/LR_Sling_Proj</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Blunt</damageDef>
      <damageAmountBase>9</damageAmountBase>
      <armorPenetrationBase>0.08</armorPenetrationBase>
      <stoppingPower>1</stoppingPower>
      <speed>42</speed>
    </projectile>
  </ThingDef>
