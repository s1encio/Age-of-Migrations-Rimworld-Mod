<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>LR_Spatha</defName>
    <label>spatha</label>
    <description>A long, straight double-edged sword. By the fifth century it had replaced the short gladius as the sword of the Roman soldier, since its reach suited both cavalry and the looser infantry formations of the time.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/LR_Spatha</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases><WorkToMake>14000</WorkToMake><Mass>1.6</Mass></statBases>
    <costList><Steel>70</Steel></costList>
    <weaponTags><li>MedievalMeleeAdvanced</li><li>LR_RomanMelee</li><li>LR_Spatha</li></weaponTags>
    <tools><li><label>handle</label><capacities><li>Blunt</li></capacities><power>7</power><cooldownTime>2</cooldownTime></li><li><label>point</label><capacities><li>Stab</li></capacities><power>14</power><cooldownTime>2.4</cooldownTime></li><li><label>edge</label><capacities><li>Cut</li></capacities><power>16</power><cooldownTime>2.4</cooldownTime></li></tools>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <recipeUsers Inherit="False"><li>FueledSmithy</li><li>ElectricSmithy</li></recipeUsers>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
      <researchPrerequisite>LR_R_Fabricae</researchPrerequisite>
    </recipeMaker>
  </ThingDef>
