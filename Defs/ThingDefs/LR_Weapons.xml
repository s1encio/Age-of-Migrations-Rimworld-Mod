  <ThingDef ParentName="BaseWeaponNeolithic">
    <defName>LR_Plumbata</defName>
    <label>plumbata</label>
    <description>A short throwing dart with a barbed iron point and a lead weight behind it. Late Roman infantry carried several clipped inside their shields and threw them overhand before the lines met. The weight lets it punch through shields and armor.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/LR_Plumbata</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>6000</WorkToMake>
      <Mass>1.2</Mass>
      <AccuracyTouch>0.75</AccuracyTouch>
      <AccuracyShort>0.6</AccuracyShort>
      <AccuracyMedium>0.4</AccuracyMedium>
      <AccuracyLong>0.2</AccuracyLong>
      <RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
    </statBases>
    <costList><Steel>25</Steel><WoodLog>10</WoodLog></costList>
    <weaponTags><li>LR_RomanRanged</li><li>LR_Plumbata</li></weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>LR_Proj_Plumbata</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>19.9</range>
        <soundCast>Bow_Small</soundCast>
      </li>
    </verbs>
    <tools><li><label>point</label><capacities><li>Stab</li></capacities><power>7</power><cooldownTime>2</cooldownTime></li></tools>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
