  <ThingDef ParentName="BuildingBase">
    <defName>LR_PalisadeParapet</defName>
    <label>breastwork palisade</label>
    <description>A palisade of sharpened stakes along the front of a fighting platform. Men on the platform behind it can shoot and throw over the points, but nobody can climb it from outside. Build it in a line with a timber walk floor behind it and an earth rampart behind that, with stairs up through the rampart.</description>
    <thingClass>AgeOfMigrations.Building_Rampart</thingClass>
    <category>Building</category>
    <graphicData>
