  <ThingDef ParentName="BuildingBase">
    <defName>LR_RampartStairs</defName>
    <label>wall stairs</label>
    <description>A flight of steps up through a curtain wall or earth rampart to the wall walk on top. The only way up: an enemy who wants the walls has to break in through the gate and fight his way up the stairs. Point the arrow at the wall walk.</description>
    <thingClass>AgeOfMigrations.Building_Rampart</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/LR/LR_RampartStairs</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <stuffCategories><li>Stony</li><li>Woody</li></stuffCategories>
    <costStuffCount>15</costStuffCount>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>8</pathCost>
