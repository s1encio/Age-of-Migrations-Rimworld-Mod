<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>LR_RampartParapet</defName>
    <label>battlement</label>
    <description>The outer edge of a city wall: a stone parapet with merlons, standing chest-high over the wall walk behind it. Defenders on the wall walk shoot out over it and duck behind it; nobody can climb it from outside. Build it in a line with a wall walk floor behind it and a curtain wall behind that, and put stairs through the curtain wall to get up.</description>
    <thingClass>AgeOfMigrations.Building_Rampart</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/LR/LR_RampartParapet_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags><li>Wall</li><li>Rock</li></linkFlags>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL><cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL><cornerBR>Damage/Corner</cornerBR>
        <edgeTop>Damage/Edge</edgeTop><edgeBot>Damage/Edge</edgeBot>
        <edgeLeft>Damage/Edge</edgeLeft><edgeRight>Damage/Edge</edgeRight>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/LR/LR_RampartParapet_MenuIcon</uiIconPath>
    <statBases>
      <MaxHitPoints>650</MaxHitPoints>
      <WorkToBuild>380</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <stuffCategories><li>Stony</li></stuffCategories>
    <costStuffCount>8</costStuffCount>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.75</fillPercent>
    <coversFloor>true</coversFloor>
    <drawStyleCategory>Walls</drawStyleCategory>
    <tickerType>Never</tickerType>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <holdsRoof>false</holdsRoof>
    <designationCategory>Structure</designationCategory>
    <uiOrder>2010</uiOrder>
    <staticSunShadowHeight>1.2</staticSunShadowHeight>
    <blockLight>false</blockLight>
    <canOverlapZones>false</canOverlapZones>
    <fertility>0</fertility>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded><researchPrerequisites><li>Stonecutting</li></researchPrerequisites>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/Wall_Blueprint_Atlas</texPath>
      </blueprintGraphicData>
    </building>
    <damageMultipliers>
      <li><damageDef>Bomb</damageDef><multiplier>2</multiplier></li>
      <li><damageDef>Thump</damageDef><multiplier>2</multiplier></li>
    </damageMultipliers>
    <modExtensions>
      <li Class="AgeOfMigrations.TallFaceExtension">
        <facePath>Things/Building/LR/LR_ParapetFace</facePath>
        <tinted>true</tinted>
        <northOnly>false</northOnly>
        <single>false</single>
      </li>
    </modExtensions>
  </ThingDef>
