<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>LR_RidgeHelmet</defName>
    <label>ridge helmet</label>
    <description>A late Roman helmet made of two iron halves joined by a central ridge, with cheek pieces and a nose guard. Cheap to make in large numbers, it became the standard helmet of the late legions.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/LR_RidgeHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingCategories Inherit="False"><li>Headgear</li></thingCategories>
    <statBases><WorkToMake>5000</WorkToMake><MaxHitPoints>120</MaxHitPoints><Mass>1.5</Mass><ArmorRating_Sharp>0.55</ArmorRating_Sharp><ArmorRating_Blunt>0.25</ArmorRating_Blunt><ArmorRating_Heat>0.12</ArmorRating_Heat><Insulation_Cold>2</Insulation_Cold><EquipDelay>1.5</EquipDelay></statBases>
    <costList><Steel>50</Steel></costList>
    <apparel>
      <bodyPartGroups><li>UpperHead</li></bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/LR_RidgeHelmet/LR_RidgeHelmet</wornGraphicPath>
      <layers><li>Overhead</li></layers>
      <tags><li>LR_West</li><li>LR_Roman</li><li>LR_RidgeHelmet</li></tags>
      <defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
    </apparel>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <recipeUsers Inherit="False"><li>FueledSmithy</li><li>ElectricSmithy</li></recipeUsers>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
      <researchPrerequisite>Smithing</researchPrerequisite>
    </recipeMaker>
  </ThingDef>
