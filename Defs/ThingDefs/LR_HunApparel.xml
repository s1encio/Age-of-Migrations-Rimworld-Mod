  <ThingDef ParentName="ApparelMakeableBase">
    <defName>LR_HunShield</defName>
    <label>Hunnic cavalry shield</label>
    <description>A small round shield of wicker covered in leather, light enough to hang on the arm while shooting from the saddle. Blocks only hits coming from the front or the sides, and only while the bearer is conscious. Worn in its own slot, so it can be combined with any weapon.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/LR_HunShield</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingCategories Inherit="False"><li>ApparelArmor</li></thingCategories>
    <statBases>
      <WorkToMake>3500</WorkToMake>
      <MaxHitPoints>90</MaxHitPoints>
      <Mass>1.8</Mass>
      <Flammability>0.8</Flammability>
      <EquipDelay>1</EquipDelay>
    </statBases>
    <costList><WoodLog>15</WoodLog><Leather_Plain>15</Leather_Plain></costList>
    <equippedStatOffsets><MoveSpeed>-0.02</MoveSpeed></equippedStatOffsets>
    <apparel>
      <bodyPartGroups><li>Hands</li></bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/LR_HunShield/LR_HunShield</wornGraphicPath>
      <layers><li>LR_Shield</li></layers>
      <tags><li>LR_Hun</li><li>LR_Shield</li><li>LR_HunShield</li></tags>
      <defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <careIfDamaged>false</careIfDamaged>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
    </apparel>
    <comps>
      <li Class="AgeOfMigrations.CompProperties_ShieldBlock">
        <rangedBlockChance>0.45</rangedBlockChance>
        <meleeBlockChance>0.3</meleeBlockChance>
        <blockArc>100</blockArc>
        <shieldDamageFactor>0.4</shieldDamageFactor>
