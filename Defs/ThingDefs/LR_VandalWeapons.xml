    </recipeMaker>
  </ThingDef>
  <ThingDef ParentName="BaseWeaponNeolithic">
    <defName>LR_Angon</defName>
    <label>angon</label>
    <description>A heavy barbed javelin with an iron shank almost as long as its wooden shaft. When it sticks in a shield, the barbs hold fast and the shank is too long to cut off, so the shield has to be dropped.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/LR_Angon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>7000</WorkToMake>
      <Mass>1.8</Mass>
      <AccuracyTouch>0.7</AccuracyTouch>
      <AccuracyShort>0.58</AccuracyShort>
      <AccuracyMedium>0.38</AccuracyMedium>
      <AccuracyLong>0.18</AccuracyLong>
      <RangedWeapon_Cooldown>1.9</RangedWeapon_Cooldown>
    </statBases>
    <costList><WoodLog>20</WoodLog><Steel>25</Steel></costList>
    <weaponTags><li>LR_VandalRanged</li><li>LR_Angon</li></weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>LR_Angon_Proj</defaultProjectile>
        <warmupTime>1.4</warmupTime>
        <range>15.9</range>
        <soundCast>Bow_Small</soundCast>
      </li>
    </verbs>
    <tools><li><label>point</label><capacities><li>Stab</li></capacities><power>10</power><cooldownTime>2.2</cooldownTime></li></tools>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <recipeUsers Inherit="False"><li>FueledSmithy</li><li>ElectricSmithy</li></recipeUsers>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
      <researchPrerequisite>Smithing</researchPrerequisite>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>LR_Angon_Proj</defName>
    <label>angon</label>
