      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases><WorkToMake>7000</WorkToMake><Mass>2.0</Mass></statBases>
    <costList><Steel>25</Steel><WoodLog>25</WoodLog></costList>
    <weaponTags><li>LR_VandalMelee</li><li>LR_Framea</li></weaponTags>
    <tools><li><label>shaft</label><capacities><li>Blunt</li></capacities><power>7</power><cooldownTime>2</cooldownTime></li><li><label>point</label><capacities><li>Stab</li></capacities><power>15</power><cooldownTime>2.3</cooldownTime></li></tools>
