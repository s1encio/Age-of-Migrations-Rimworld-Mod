<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>LR_Seax</defName>
    <label>seax</label>
    <description>A long single-edged knife with a heavy back, carried by every Germanic free man as tool and weapon alike. Short, but very quick.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/LR_Seax</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases><WorkToMake>8000</WorkToMake><Mass>0.8</Mass></statBases>
    <costList><Steel>45</Steel></costList>
    <weaponTags><li>LR_VandalMelee</li><li>LR_Seax</li></weaponTags>
    <tools><li><label>handle</label><capacities><li>Blunt</li></capacities><power>6</power><cooldownTime>1.8</cooldownTime></li><li><label>point</label><capacities><li>Stab</li></capacities><power>11</power><cooldownTime>1.8</cooldownTime></li><li><label>edge</label><capacities><li>Cut</li></capacities><power>12</power><cooldownTime>1.9</cooldownTime></li></tools>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <recipeUsers Inherit="False"><li>FueledSmithy</li><li>ElectricSmithy</li></recipeUsers>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
      <researchPrerequisite>Smithing</researchPrerequisite>
    </recipeMaker>
  </ThingDef>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>LR_BeardedAxe</defName>
    <label>bearded axe</label>
    <description>A war axe with a long, drooping lower blade that can hook a shield rim or a leg. Cheap to make and terrible in a crush.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/LR_BeardedAxe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases><WorkToMake>9000</WorkToMake><Mass>1.8</Mass></statBases>
    <costList><Steel>45</Steel><WoodLog>20</WoodLog></costList>
    <weaponTags><li>LR_VandalMelee</li><li>LR_BeardedAxe</li></weaponTags>
    <tools><li><label>handle</label><capacities><li>Blunt</li></capacities><power>7</power><cooldownTime>2</cooldownTime></li><li><label>beard</label><capacities><li>Cut</li></capacities><power>17</power><cooldownTime>2.6</cooldownTime></li></tools>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
